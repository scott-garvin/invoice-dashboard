{
  "name": "invoice-dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Ledgerly invoicing workspace with a payment ledger and reviewed AI intake",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:api": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-schema.mjs",
    "start": "node build/server/index.js",
    "mcp": "tsx mcp/index.ts",
    "mcp:demo": "tsx mcp/demo.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.17",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@lucide/vue": "^1.48.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
